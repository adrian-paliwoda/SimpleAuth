@page
@model Page.Account.Login

@{
    ViewData["Title"] = "Login Page";
}
<h1>@ViewData["Title"]</h1>

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - AnonymousIdentityApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/AnonymousIdentityApp.styles.css" asp-append-version="true"/>
</head>
<body>
<div>
    @if (Model.IsLogin)
    {
        <h1>You are logged in</h1>
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="btn btn-primary">Log out</button>
        </form>
    }
    
    @if (!Model.IsLogin)
    {
        <form method="post">
            <div class="text-danger" asp-validation-summary="ModelOnly"></div>
            <div class="form-group row">
                <div class="col-2">
                    <label asp-for="Credential.UserName"></label>
                </div>
                <div class="col-5">
                    <input type="text" asp-for="Credential.UserName" class="form-control"/>
                </div>
                <span class="text-danger" asp-validation-for="Credential.UserName"></span>
            </div>
            <div class=""></div>
            <div class="text-danger" asp-validation-summary="ModelOnly"></div>
            <div class="form-group row">
                <div class="col-2">
                    <label asp-for="Credential.Password"></label>
                </div>
                <div class="col-5">
                    <input type="password" asp-for="Credential.Password" class="form-control"/>
                </div>
                <span class="text-danger" asp-validation-for="Credential.Password"></span>
            </div>
            <div class="form-group row">
                <div class="col-2">
                    <input type="submit" class="btn btn-primary" value="Login"/>
                </div>
                <div class="col-5">

                </div>
            </div>
        </form>
    }
</div>
</body>
</html>